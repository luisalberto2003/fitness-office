# Configuracion del servidor
PORT=4000
NODE_ENV=development

# Base de datos
# Para produccion (PostgreSQL - Railway/Render/etc.)
DB_DIALECT=postgres
DATABASE_URL=postgres://usuario:password@host:5432/fitness_office

# Para desarrollo local sin instalar PostgreSQL, usar sqlite:
# DB_DIALECT=sqlite

# JWT
JWT_SECRET=cambiar_este_secreto_en_produccion
JWT_EXPIRES_IN=8h

# Usuario administrador inicial (se crea con el seed)
ADMIN_EMAIL=admin@fitnessoffice.com
ADMIN_PASSWORD=Admin1234
